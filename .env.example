# Copy to .env for local development. Never commit the real .env.
ENV=development
HOST=127.0.0.1
PORT=8000

# Public origin used for canonical / Open Graph URLs (set to your real domain in production)
SITE_URL=http://localhost:8000

# Set to true ONLY when running behind a trusted reverse proxy (Render, Caddy, nginx...)
TRUST_PROXY=false
# Optional header carrying the real client IP from your trusted proxy (e.g. true-client-ip)
# CLIENT_IP_HEADER=

# Optional memory caps
# MAX_ACTIVE_SECRETS=2000
# MAX_RATE_LIMIT_KEYS=50000
# CORS_ORIGINS=https://secret.example.com

